{
  "manifest_version": 3,
  "name": "Momo Catcher",
  "version": "0.2.14",
  "description": "在指定時間把商品加入 momo 購物車，回應時間顯示在擴充套件面板。",
  "permissions": ["alarms", "notifications", "storage", "tabs", "scripting", "windows"],
  "host_permissions": [
    "https://www.momoshop.com.tw/*",
    "https://cart.momoshop.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Momo Catcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
